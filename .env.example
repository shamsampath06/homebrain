# HomeBrain Environment Configuration

PORT=5000

# Public Supabase browser configuration. Never put a service-role key here.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-publishable-or-anon-key"

# Server-only secrets belong in the deployment environment, not VITE_* variables.
SUPABASE_SERVICE_ROLE_KEY=""
