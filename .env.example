# HomeBrain Environment Configuration

PORT=5000

# Public Supabase browser configuration. Never put a service-role key here.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-publishable-or-anon-key"

# Server-only secrets belong in the deployment environment, not VITE_* variables.
SUPABASE_SERVICE_ROLE_KEY=""

# AI Models (Gemini 2.5 Flash / OpenAI fallback)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Emergency SOS - Cellular SMS Provider (Twilio - Global)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Emergency SOS - Cellular SMS Provider (Fast2SMS - India)
FAST2SMS_API_KEY=""

# Emergency SOS - Email Provider (Resend)
RESEND_API_KEY=""
EMAIL_FROM="HomeBrain SOS <onboarding@resend.dev>"

